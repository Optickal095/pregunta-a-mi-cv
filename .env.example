# API key gratuita de Groq: https://console.groq.com/keys
GROQ_API_KEY=

# API key gratuita de Gemini, para los embeddings: https://aistudio.google.com/apikey
# Sin ella, cada pregunta envía el CV completo en vez de buscar las partes relevantes.
GEMINI_API_KEY=

# Modelo de Groq (opcional)
GROQ_MODEL=openai/gpt-oss-120b

# Fragmentos del CV que se envían al modelo por pregunta (opcional)
RAG_TOP_K=4

# Modelo de embeddings de Gemini (opcional)
EMBEDDINGS_MODEL=gemini-embedding-2

# Orígenes permitidos por CORS, separados por coma (opcional)
CORS_ORIGINS=http://localhost:4200,https://optickal095.github.io

# Proxies delante de la API, para que el límite por IP vea la IP real (opcional)
TRUST_PROXY_HOPS=1

PORT=3000
